{
  "name": "npm-update-interactive",
  "version": "1.1.0",
  "description": "Upgrade your npm dependencies interactively.",
  "type": "module",
  "keywords": [
    "npm",
    "update",
    "upgrade",
    "dependencies"
  ],
  "repository": "github:apexskier/npm-update-interactive",
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "prepare": "npm run lint && npm run build"
  },
  "files": [
    "dst"
  ],
  "bin": {
    "npm-update-interactive": "dst/index.js"
  },
  "author": "Cameron Little <cameron@camlittle.com> (https://camlittle.com)",
  "license": "ISC",
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "tsx": "^4.17.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.9.0",
    "ansi-escapes": "^7.2.0",
    "commander": "^12.1.0",
    "open": "^10.2.0",
    "semver": "^7.6.3",
    "yoctocolors-cjs": "^2.1.3"
  }
}
